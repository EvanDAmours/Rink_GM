{
  "name": "nhl-gm",
  "version": "1.0.0",
  "description": "Rink GM \u2014 a browser hockey general manager game built on EA SPORTS NHL 27 roster ratings.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "validate:rosters": "node scripts/validate-rosters.mjs",
    "build:artifact": "vite build && node scripts/build-artifact.mjs",
    "refresh:schedule": "node scripts/refresh-schedule.mjs",
    "test:render": "node scripts/render-smoke.mjs",
    "test:visibility": "node scripts/visibility-smoke.mjs",
    "test:dynasty": "node scripts/dynasty-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.cjs",
    "refresh:records": "node scripts/refresh-historical-records.mjs",
    "refresh:logos": "node scripts/refresh-logos.mjs",
    "build:pages": "vite build && node scripts/build-artifact.mjs",
    "refresh:players": "python3 scripts/refresh-player-data.py",
    "test:simulation": "node scripts/simulation-audit.mjs",
    "test:season": "node scripts/season-audit.mjs",
    "test:positions": "node scripts/positional-audit.mjs"
  },
  "dependencies": {
    "lz-string": "1.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.11"
  }
}
